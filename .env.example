# ─────────────────────────────────────────────────────────────
# 이 파일은 '예시'다. 실제로 쓰려면 이름을 .env 로 바꾸고 값을 채운다.
#
#   cp .env.example .env
#
# .env 는 .gitignore에 등록돼 있어 Git에 올라가지 않는다.
# 이 .env.example 만 팀에 공유하면 된다. (키는 각자 넣기)
# ─────────────────────────────────────────────────────────────

# OpenAI API 키. platform.openai.com → API keys 에서 발급.
# 따옴표 없이, 한 줄로, 앞뒤 공백 없이 붙여넣을 것.
OPENAI_API_KEY=sk-여기에_실제_키를_넣으세요

# GPT를 호출하지 않고 검색·안전장치만 확인하려면 1로 둔다.
# 비워두거나 0이면 실제 호출한다.
MCM_MOCK=

# ── Spring 서버(광은님 MCMcare_Back) 연동 ──────────────────
# 비워두면 as_dummy.json(더미)으로 동작한다. 개발 중에는 비워둬도 된다.
SPRING_API_URL=
# 위 서버가 JWT를 요구하면 토큰을 넣는다. 필요 없으면 비워둔다.
SPRING_API_TOKEN=
# 응답 대기 시간(초). 서버가 느려도 챗봇이 멈추지 않게 짧게 잡는다.
SPRING_TIMEOUT=3
